### Test-Set Performance (Held-Out Data)

Refit each tuned model on the **full training set** and score once on the **untouched test set** — the only numbers that matter for judging real-world generalization.
def get_scores(estimator, X):
    if hasattr(estimator, "predict_proba"):
        return estimator.predict_proba(X)[:, 1]
    return estimator.decision_function(X)

test_results = {}
y_pred_by_model = {}
y_score_by_model = {}

for name, est in best_estimators.items():
    est.fit(X_train, y_train)
    y_pred = est.predict(X_test)
    y_score = get_scores(est, X_test)

    y_pred_by_model[name] = y_pred
    y_score_by_model[name] = y_score

    test_results[name] = {
        "accuracy": accuracy_score(y_test, y_pred),
        "roc_auc": roc_auc_score(y_test, y_score),
        "average_precision": average_precision_score(y_test, y_score),
        "precision": precision_score(y_test, y_pred),
        "recall": recall_score(y_test, y_pred),
        "f1": f1_score(y_test, y_pred),
        "f0.5": fbeta_score(y_test, y_pred, beta=0.5),
    }

test_results_df = pd.DataFrame(test_results).T.sort_values("roc_auc", ascending=False)
display(test_results_df.round(4))
test_results_df[["roc_auc", "average_precision", "f1", "f0.5", "precision", "recall"]].plot(
    kind="bar", figsize=(11, 5)
)
plt.title("Test-Set Performance by Model")
plt.ylabel("Score")
plt.ylim(0, 1)
